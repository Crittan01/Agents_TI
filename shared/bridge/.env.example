# Ansible Automation Platform
AWX_URL=https://<IP_O_FQDN_DEL_AAP>
AWX_TOKEN=<TOKEN_DE_USUARIO_AAP>

# Job Templates
HEALTH_JOB_TEMPLATE_ID=<ID_DEL_JOB_TEMPLATE_DE_SALUD>
LOG_JOB_TEMPLATE_ID=<ID_DEL_JOB_TEMPLATE_DE_LOGS>
INVENTORY_ID=<ID_DEL_INVENTARIO>

# Teams (bot unificado)
TEAMS_WEBHOOK_URL=<INCOMING_WEBHOOK_URL_DE_TEAMS>
TEAMS_HMAC_TOKEN=<SECURITY_TOKEN_DEL_OUTGOING_WEBHOOK>

# Claude NLU
ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>

# Inventario (para NLU)
INVENTORY_PATH=../../shared/inventory/hosts_inventario
NAMING_CONVENTION_PATH=../docs/naming_convention.md
# Relativo al directorio de nlu.py (shared/bridge/) — no al CWD de quien lo llama
